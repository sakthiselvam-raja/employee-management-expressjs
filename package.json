{
  "name": "ism-file-assign-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Express + Prisma (PostgreSQL) API for the ISM admin/user file assignment system",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon --watch src --ext js src/server.js",
    "start": "node src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "seed": "node prisma/seed.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "engines": {
    "node": ">=18.18"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "yauzl": "^3.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "prisma": "^6.16.0"
  }
}
