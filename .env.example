# ---------- Database ----------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://ism_user:ism_password@localhost:5432/ism_file_assign?schema=public"

# ---------- Server ----------
PORT=5000
NODE_ENV=development
# Frontend URL allowed to call the API with cookies (Vite dev server by default)
CLIENT_ORIGIN=http://localhost:5173

# ---------- Auth ----------
# Use a long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=8h
# Set to true when the site is served over HTTPS
COOKIE_SECURE=false

# Admin account (created/synced automatically every time the server starts)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin@123
ADMIN_EMAIL=admin@ism.local

# Default password given to every user the admin creates (and on "reset password")
DEFAULT_USER_PASSWORD=ism@123

# ---------- File storage ----------
# Folder where ZIPs, extracted files and user submissions are stored
STORAGE_DIR=./storage
# Max ZIP upload size and max total extracted size (in MB)
# 5 GB ZIP uploads: allow a little headroom. Disk needs ~2.3x the ZIP size free (ZIP + extracted copy).
MAX_ZIP_SIZE_MB=6144
MAX_EXTRACTED_SIZE_MB=12288
# Max size of an Excel file a user re-uploads (in MB)
MAX_SUBMISSION_SIZE_MB=50
